# Required backend/evolve variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Optional: use remote database for Docker backend.
# If omitted, docker-compose uses persistent local SQLite volume.
# DOCKER_DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# Optional backend settings
LOCAL_AUTH=false
LOCAL_AUTH_SECRET=change-me
ENABLE_RETRAIN_SCHEDULER=false
MIN_TRAINING_ROWS=25

# Optional evolve settings
MODEL_UPDATE_INTERVAL_SECONDS=3600

# Optional frontend build args (only needed for Supabase auth in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
